# Copy this file to .env for local development.
# Never commit real credentials or secrets.

MONGODB_URL=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary
CLOUD_NAME=your-cloud-name
API_KEY=your-api-key
SECRET_KEY=your-api-secret

# Mail
MAIL_ID=your-email@example.com
MP=your-mail-app-password

# Frontend origin for links in password-reset emails
FRONTEND_URL=http://localhost:3000

# Razorpay (required for checkout; never expose the secret to the frontend)
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
